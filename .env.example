# Copy to .env and fill in real secrets. .env is git-ignored and never committed.
# Compose injects this file into the container (env_file: .env).

# From BotFather.
TELEGRAM_BOT_TOKEN=
# In `telegram_mode: gateway` (#95) the token is not needed here; this module secret
# (the gateway's WATCHDOG_SECRET, 32+ characters) takes its place:
# WATCHDOG_SECRET=
# The t6 API: Contacts, Projects, Departments, Job Orders (raise, find, read), Contact and
# Project matching, extraction through `llm run` and Deliverable matching through `llm decide`.
# The key's service is `watchdog`, with the `unmasked`, `llm` and `coordinator` permissions
# (`jo raise` needs `coordinator`): without `unmasked` names come back masked and resolution fails.
T6_API_URL=
T6_API_SECRET=
